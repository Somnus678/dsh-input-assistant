{
  "name": "dsh-input-assistant",
  "version": "0.1.2",
  "description": "DSH 输入助手：提示词优化、下一句预测、输入续写与当前会话草稿暂存",
  "type": "module",
  "license": "MIT",
  "author": "dsh-input-assistant contributors",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "prompt",
    "prompt-optimization",
    "autocomplete",
    "inline-completion",
    "next-sentence-prediction",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Somnus678/dsh-input-assistant.git"
  },
  "homepage": "https://github.com/Somnus678/dsh-input-assistant#readme",
  "bugs": {
    "url": "https://github.com/Somnus678/dsh-input-assistant/issues"
  },
  "engines": { "node": ">=22.19", "dsh": "0.2.1-rc.2" },
  "packageManager": "pnpm@11.28.5",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./core": "./lib/core.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/CHANGELOG-0.1.2.md",
    "docs/evaluation.md",
    "docs/references.md",
    "docs/smoke-comparison.md",
    "docs/validation.md"
  ],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-model-selection", "@deepseek-ai/dsh-client-ui-settings"], "platform": "web" } },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:release": "pnpm typecheck && pnpm build && pnpm pack --pack-destination dist && pnpm test && pnpm test:package",
    "test:package": "node scripts/verify-package.mjs",
    "test:web": "node scripts/smoke-web.mjs",
    "eval:validate": "node scripts/evaluate.mjs validate",
    "eval:export": "node scripts/evaluate.mjs export",
    "eval:score": "node scripts/evaluate.mjs score"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@testing-library/react": "16.3.0",
    "@playwright/test": "1.56.1",
    "lexical": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@lexical/history": "0.49.0",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
